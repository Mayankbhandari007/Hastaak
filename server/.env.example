# Copy to .env and fill in. .env is read at startup and never sent to the browser.
PROVIDER=sarvam
SARVAM_API_KEY=
SARVAM_CHAT_MODEL=sarvam-105b
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
# Optional voice for bulbul:v3, e.g. priya, ritu, neha, shubh, aditya (empty = Sarvam's default)
SARVAM_TTS_SPEAKER=
