# Copy to .env and fill in. .env is read at startup and never sent to the browser.
# All AI calls go through server/meta.py (Meta Model API; MMS-TTS runs on this machine).

# Meta Model API (https://dev.meta.ai/docs)
MODEL_API_KEY=
META_CHAT_MODEL=muse-spark-1.3
# Muse Spark always reasons; minimal is the fastest and cheapest setting
META_REASONING=minimal
META_STT_MODEL=muse-voice-transcribe-1.0
