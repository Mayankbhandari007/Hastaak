{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "dev", "--", "--port", "5173", "--strictPort"],
      "port": 5173
    },
    {
      "name": "server",
      "runtimeExecutable": "server/.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "main:app", "--app-dir", "server", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "vision",
      "runtimeExecutable": "python/.venv/Scripts/python.exe",
      "runtimeArgs": ["python/vision_server.py"],
      "port": 8001
    }
  ]
}
